#include<iostream>
using namespace std;
class ps
{
	private:
		int ts,ms;
	public:
		void nhap()
		{
			cout<<"Nhap tu so: "; cin>>ts;
			do
			{
				cout<<"Nhap mau so: "; cin>>ms;
			}while(ms==0);
		}
		void xuat()
		{
			cout<<"Phan so: "<<ts<<"/"<<ms<<endl;
			cout<<"----------------------------"<<endl;
		}
		ps cong(int m);
		friend ps tru(int t,ps a);
		friend ps nhan(int z,ps a);
		friend ps rutgon(ps a);
		friend ps chia(ps a,ps b);
};
int ucln(int q,int w)
{
	if(w==0) {
	return q;	
	}
		return ucln(w,q%w);
}
ps rutgon(ps a)
{
	ps c;
	int x=ucln(a.ts,a.ms);
	c.ts = a.ts / x;
	c.ms = a.ms / x;
	return c;
}
ps ps::cong(int m)
{
	ps c;
	c.ts=m*ms+ts;
	c.ms=ms;
	return c;
}
ps tru(int t,ps a)
{
	ps c;
	c.ts = t*a.ms - a.ts;
	c.ms = a.ms;
	return c;
}
ps nhan(int z,ps a)
{
	ps c;
	c.ts= a.ts*z;
	c.ms= a.ms;
	return c;
}
ps chia(ps a,ps b)
{
	ps c;
	c.ts = a.ts * b.ms;
	c.ms = a.ms * b.ts;
	return c;
}
int main()
{
	ps a,b,c;
	int m,t,z;
	a.nhap(); a.xuat();
	cout<<"Rut gon: "; a=rutgon(a);
	a.xuat();
	
	cout<<"Nhap so cong: "; cin>>m;
	c=a.cong(m);
	c=rutgon(c);
	cout<<"Phan so cong xong va rut gon: "<<endl;
	c.xuat();
	
	cout<<"Nhap so bi tru: "; cin>>t;
	c=tru(t,a);
	c=rutgon(c);
	cout<<"Phan so tru xong va rut gon: "<<endl;
	c.xuat();
	
	cout<<"Nhap so nhan: "; cin>>z;
	c=nhan(z,a);
	c=rutgon(c);
	cout<<"Phan so nhan xong va rut gon: "<<endl;
	c.xuat();
	
	b.nhap();
	c=chia(a,b);
	c=rutgon(c);
	cout<<"Phan so chia xong va rut gon: "<<endl;
	c.xuat();
	
	return 0;
}
